server {
    listen 80 default_server;
    server_name  _;

    real_ip_recursive on;
    real_ip_header X-Forwarded-For;
    set_real_ip_from  192.168.0.0/16;
    set_real_ip_from  10.0.0.0/8;
    client_max_body_size 80M;

    # Never serve a dependency tree or a dotfile out of the static root.
    # Regex locations are matched before the /static prefix below, so these
    # win. This is not only belt-and-braces: setup_templates.sh (the docker
    # build path) runs `npm i` INSIDE ./static/js after collectstatic, so
    # node_modules reappears in STATIC_ROOT no matter what collectstatic is
    # told to ignore -- ~1.4GB of third-party files, some of which ship test
    # fixtures like keys and certs. collectstatic's ignore list (see
    # scripts/collectstatic_ignores.sh) handles the build_static.sh path;
    # this handles the other one and any future regression.
    #
    # .well-known must stay reachable (ACME/cert renewal, apple-app-site-
    # association), so it is matched first and falls through to the app.
    location ~ ^/\.well-known/ {
	proxy_pass http://127.0.0.1:8010;
	proxy_set_header Host $host;
    }
    location ~ /node_modules/ {
	deny all;
    }
    location ~ /\. {
	deny all;
    }

    location /static {
	root /opt/fighthealthinsurance/;
    }
    location /media {
	root /opt/fighthealthinsurance/;
    }

    location /ws {
	proxy_pass http://127.0.0.1:8010;
	proxy_set_header Host $host;
	proxy_http_version 1.1;
	proxy_set_header Upgrade $http_upgrade;
	proxy_set_header Connection "upgrade";
	# Idle websocket timeout. Without these nginx falls back to its 60s
	# default and drops sockets that go quiet mid-conversation -- a chat
	# socket while the user reads/types, or a gap between the server's
	# ~20-45s keep-alive frames. The application governs its own limits:
	# the appeal client escalates to REST after 90s of frame silence and
	# hard-caps the socket at 7min (WS_HARD_TIMEOUT_MS in appeal_fetcher.ts).
	# Give nginx 10min of idle headroom -- above that 7min app cap -- so this
	# in-pod proxy is never the layer that severs a still-live connection.
	# The ingress already allows an hour; this proxy in front of uvicorn was
	# the real 60s bottleneck.
	proxy_read_timeout 600s;
	proxy_send_timeout 600s;
    }

    location / {
	proxy_pass http://127.0.0.1:8010;
	proxy_set_header Host $host;
	# The REST polling/streaming fallback (NDJSON under /ziggy/rest/) and
	# long POSTs (OCR, appeal generation kickoff) run well past nginx's 60s
	# proxy_read_timeout default; hitting it severs the stream mid-appeal
	# with a 504 the client can't distinguish from a dead backend. Match
	# the /ws budget so this in-pod proxy is never the layer that cuts a
	# still-live response.
	proxy_read_timeout 600s;
	proxy_send_timeout 600s;
	# Keep-alive to upstream + required for chunked streaming responses to
	# pass through without buffering the whole body first.
	proxy_http_version 1.1;
	proxy_buffering off;
    }
}

log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
		  '$status $body_bytes_sent "$http_referer" '
		  '"$http_user_agent" "$http_x_forwarded_for"';
