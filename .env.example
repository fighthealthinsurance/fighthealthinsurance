# Fight Health Insurance: environment variable template
#
# Copy this file to .env and fill in what you need. Placeholders only: never
# put a real key in this template. (.env itself is in .gitignore.)
#
# The model backend settings (the MODEL BACKENDS section below) and the few
# others read through get_env_variable (fighthealthinsurance/env_utils.py),
# such as DJANGO_SETTINGS_MODULE, check the process environment first and
# this file second. They read this file only on a local run: never under
# tests (the Test, TestSync and TestActor configurations, or pytest) and never
# in a deployment. Nothing loads .env into the process environment, and every
# other setting is read with os.getenv, so for those export the file into the
# shell that starts the server:
#
#   set -a; . ./.env; set +a
#
# Everything below DJANGO_CONFIGURATION is commented out, so exporting an
# unedited copy sets only DJANGO_CONFIGURATION. Uncomment the lines you set.
#
# tox passes your whole shell environment to the tests (passenv = * in
# tox.ini), so whatever you export here also reaches test runs. A value you
# leave in this file without exporting it never does.
#
# This lists the common settings, not every variable the code reads. More
# detail: docs/ml-backends.md (model backends), docs/model-backend-health.md
# (deploy health check), docs/geoip.md (GeoIP), API_KEYS_SETUP.md (NICE,
# NCBI, Log Analytics).

# =============================================================================
# DJANGO
# =============================================================================
# Settings class: Dev, Test, TestSync, TestActor or Prod. When unset, the app
# uses ENVIRONMENT, else Dev. tox sets its own value for each test env.
DJANGO_CONFIGURATION=Dev

# Settings module. The default is fighthealthinsurance.settings.
# DJANGO_SETTINGS_MODULE=fighthealthinsurance.settings

# Django secret key. Read by Prod only; Dev and the test classes use a fixed
# insecure key.
# SECRET_KEY=your-secret-key-here

# =============================================================================
# DATABASES
# =============================================================================
# Dev: path of the SQLite database. Defaults to db.sqlite3 in the repo root.
# DEV_DB_LOC=db.sqlite3

# Prod: PostgreSQL database name for the default database.
# PDBNAME=fighthealthinsurance
# Prod: PostgreSQL user.
# PDBUSER=your-db-user
# Prod: PostgreSQL password.
# PDBPASSWORD=your-db-password
# Prod: PostgreSQL host.
# PDBHOST=localhost

# Prod: the second database alias, "mysql". Leave these unset on a dev
# machine: the TestActor test settings also read DBNAME, as the path of their
# SQLite file.
# DBNAME=fighthealthinsurance_mysql
# Prod: MySQL user.
# DBUSER=your-mysql-user
# Prod: MySQL password.
# DBPASSWORD=your-mysql-password
# Prod: MySQL host.
# DBHOST=localhost

# =============================================================================
# STRIPE
# =============================================================================
# Stripe test secret key, used by every class except Prod.
# STRIPE_TEST_SECRET_KEY=sk_test_your-key
# Stripe test publishable key, used by every class except Prod.
# STRIPE_TEST_PUBLISHABLE_KEY=pk_test_your-key
# Stripe live secret key, used by Prod.
# STRIPE_LIVE_SECRET_KEY=sk_live_your-key
# Stripe live publishable key, used by Prod.
# STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_your-key
# Signing secret for Stripe webhook events.
# STRIPE_WEBHOOK_SECRET=whsec_your-secret

# =============================================================================
# RECAPTCHA
# =============================================================================
# reCAPTCHA site key, read by Prod only. Prod enforces reCAPTCHA only when
# both keys are set. Dev turns it off in settings.py, so it needs neither.
# RECAPTCHA_PUBLIC_KEY=your-recaptcha-site-key
# reCAPTCHA secret key, read by Prod only.
# RECAPTCHA_PRIVATE_KEY=your-recaptcha-secret-key

# =============================================================================
# EMAIL (Prod only; Dev writes outgoing mail to files in sent_emails/)
# =============================================================================
# SMTP server. Defaults to pigscanfly.ca.
# EMAIL_HOST=smtp.your-provider.com
# SMTP port. Defaults to 25. 465 uses SSL; any other port uses STARTTLS.
# EMAIL_HOST_PORT=587
# SMTP user. Defaults to support.
# EMAIL_HOST_USER=your-email-user
# SMTP password.
# EMAIL_HOST_PASSWORD=your-email-password

# =============================================================================
# OBJECT STORAGE (Prod only: the second, MinIO/S3-compatible storage backend)
# =============================================================================
# Access key.
# EX_MINIO_ACCESS=your-access-key
# Secret key.
# EX_MINIO_SECRET=your-secret-key
# Region.
# EX_MINIO_REGION=us-east-1
# Endpoint host. EX_MINIO_HOST is read as a fallback.
# EX_MINIO_HOST_ENDPOINT=minio.your-domain.com
# Bucket name. Unless endpoint, access key, secret key and bucket are all
# set, this backend is skipped and an error is logged.
# EX_MINIO_BUCKET=fhi-media

# =============================================================================
# ENCRYPTED FILE FIELDS
# =============================================================================
# Salt for the encrypted file fields. When unset, Prod falls back to
# base-salt and the other classes to a fixed dev or test value, so set a real
# value in production.
# DEFF_SALT=your-encryption-salt
# Password for the encrypted file fields. Same fallbacks (base-password in
# Prod).
# DEFF_PASSWORD=your-encryption-password

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================
# Sentry DSN. Sentry starts only in a real deployment: DEBUG off and either
# KUBERNETES_SERVICE_HOST (set in every Kubernetes pod) or FHI_DEPLOYED=1 in
# the process environment. A real DSN here reports nothing from local dev.
# SENTRY_ENDPOINT=https://your-key@sentry.example.com/your-project

# Set to true to turn on audit logging (fhi_users/audit.py). Off by default.
# ENABLE_AUDIT_LOGGING=false

# Azure Log Analytics workspace ID. Log shipping turns on only when both the
# ID and the key are set. See API_KEYS_SETUP.md.
# LOG_ANALYTICS_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
# Azure Log Analytics workspace shared key.
# LOG_ANALYTICS_WORKSPACE_KEY=your-workspace-key
# Destination custom-log table. Defaults to FightHealthInsurance.
# LOG_ANALYTICS_LOG_TYPE=FightHealthInsurance

# =============================================================================
# EVIDENCE SOURCES (see API_KEYS_SETUP.md)
# =============================================================================
# NICE syndication API key. Without it the NICE lookup is skipped. Tests
# never reach the real API; see API_KEYS_SETUP.md.
# NICE_API_KEY=your-nice-api-key
# NCBI API key. PubMed works without it, at a lower rate limit.
# NCBI_API_KEY=your-ncbi-api-key
# ClinicalTrials.gov API base. Defaults to https://clinicaltrials.gov/api/v2.
# CLINICAL_TRIALS_API_BASE=https://clinicaltrials.gov/api/v2

# ======================================================================
# --- Self-hosted, OpenAI-compatible servers (for example vLLM). The app calls
# http://HOST:PORT/v1. Don't use port 8000 on localhost: scripts/run_local.sh
# serves the web app there. On a machine where kubectl can see the team's
# cluster, run_local.sh sets HEALTH_BACKEND_* and NEW_HEALTH_BACKEND_* itself,
# overriding these.

# Legacy internal backend (fhi-legacy) host.
# HEALTH_BACKEND_HOST=localhost
# Legacy internal backend port. Defaults to 80.
# HEALTH_BACKEND_PORT=8001
# Served model name. Defaults to totallylegitco/fighthealthinsurance_model_v0.5.
# HEALTH_BACKEND_MODEL=your-served-model-name

# Current internal backend host.
# NEW_HEALTH_BACKEND_HOST=localhost
# Current internal backend port. Defaults to 80.
# NEW_HEALTH_BACKEND_PORT=8002
# Served model path. Defaults to
# /models/fhi-2025-may-0.3-float16-q8-vllm-compressed.
# NEW_HEALTH_BACKEND_MODEL=/models/your-model

# Alpha internal backend host.
# ALPHA_HEALTH_BACKEND_HOST=localhost
# Alpha internal backend port. Defaults to 8000, so set it when the server
# runs on the same machine as the dev server.
# ALPHA_HEALTH_BACKEND_PORT=8003
# Served model path. Defaults to /models/fhi-2025-nov-q8-vllm-compressed.
# ALPHA_HEALTH_BACKEND_MODEL=/models/your-model

# --- Hosted APIs. A backend registers only when its key (and, for Azure, its
# endpoint) is set.

# Anthropic API key. Registers anthropic/claude-* models.
# ANTHROPIC_API_KEY=your-anthropic-api-key

# DeepInfra API key.
# DEEPINFRA_API=your-deepinfra-api-key

# Perplexity API key. Citations only: Perplexity never generates an appeal.
# PERPLEXITY_API=your-perplexity-api-key

# Azure OpenAI (GPT) key. Registers models as azure-openai/<deployment>.
# AZURE_OPENAI_API_KEY=your-azure-openai-key
# Azure OpenAI endpoint: the OpenAI-compatible /openai/v1 base URL.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
# Comma-separated deployment names. Replaces the default list (gpt-5.5).
# A listed name the code already knows keeps its routing tier; an
# unknown one registers at the "custom" tier.
# AZURE_OPENAI_MODELS=gpt-5.5

# Azure AI Foundry (Claude) key. Registers models as
# azure-anthropic/<deployment>.
# AZURE_ANTHROPIC_API_KEY=your-azure-foundry-key
# Azure AI Foundry endpoint: the base URL ending in /anthropic. The
# /v1/messages path is appended automatically.
# AZURE_ANTHROPIC_ENDPOINT=https://your-resource.services.ai.azure.com/anthropic
# Comma-separated deployment names. Replaces the default list
# (claude-opus-4-8, claude-fable-5).
# A listed name the code already knows keeps its routing tier; an
# unknown one registers at the "custom" tier.
# AZURE_ANTHROPIC_MODELS=claude-opus-4-8,claude-fable-5

# Comma-separated allow-list of remote generation models, by friendly name
# (as printed in the "All loaded models" log line) or internal name. Unset or
# blank loads every configured model. Internal models and context-only models
# such as Perplexity always load.
# ENABLED_REMOTE_MODELS=azure-anthropic/claude-opus-4-8,azure-openai/gpt-5.5

# =============================================================================
# DEPLOY-TIME MODEL HEALTH CHECK (docs/model-backend-health.md)
# =============================================================================
# Read by `manage.py check_model_backends`, which the deploy hook runs with
# --deploy-hook. A local run_local.sh session never calls it.

# 1 (or true, yes) makes the deploy hook fail when an enabled backend fails.
# Default: log and email only.
# FHI_MODEL_HEALTH_STRICT=1
# Deploy-hook failure email to support42@fighthealthinsurance.com. Unset: on,
# except when DEBUG is on or under tests. 1 forces it on, 0 forces it off.
# FHI_MODEL_HEALTH_ALERT_EMAIL=1
# Per-backend probe timeout in seconds. Defaults to 30.
# FHI_MODEL_HEALTH_TIMEOUT=30
# Deployment identifier for the once-per-deployment claim. Falls back to
# FHI_RELEASE (set in the image), then FHI_VERSION, then an hourly timestamp.
# FHI_DEPLOYMENT_ID=v0.0.0
